---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found — Valstrid" description="The page you're looking for doesn't exist.">
  <main class="not-found">
    <div class="nf-inner">
      <span class="nf-code">404</span>
      <h1 class="nf-title">Page not found</h1>
      <p class="nf-desc body-lg">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a href="/" class="btn btn-primary">
        Back to home
        <svg class="arrow-icon" width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 12L12 2M12 2H5M12 2V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </main>
</Layout>

<style>
  .not-found {
    min-height: calc(100vh - 56px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--section-py) var(--section-px);
  }

  .nf-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    max-width: 440px;
  }

  .nf-code {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(72px, 12vw, 120px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--border-2);
    display: block;
    margin-bottom: 4px;
  }

  .nf-title {
    font-family: var(--font-serif);
    font-size: clamp(24px, 3vw, 36px);
    letter-spacing: -0.025em;
    color: var(--text);
    line-height: 1.2;
  }

  .nf-desc {
    margin-bottom: 8px;
  }
</style>
