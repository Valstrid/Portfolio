---
const testimonials = [
  {
    quote: 'Working with Valstrid was exceptional. The site launched in under 4 weeks and we saw a 3× increase in signups within the first month. Real collaboration, not just delivery.',
    person: 'Sarah Chen',
    title: 'Co-founder & CEO',
    company: 'Build Club',
    initials: 'SC',
    avatarBg: '#1a0a38',
  },
  {
    quote: 'Valstrid redesigned our investor portal from the ground up. LPs notice the difference immediately — polished, professional, and exactly on-brand for a growth equity firm.',
    person: 'Marcus Reid',
    title: 'Managing Partner',
    company: 'Arconic Capital',
    initials: 'MR',
    avatarBg: '#0a1830',
  },
  {
    quote: 'Few designers combine strategic thinking with execution speed like Valstrid. The brand feels like us — but the best version of us. We\'ve had nothing but compliments since launch.',
    person: 'Priya Nair',
    title: 'Head of Product',
    company: 'Preve Health',
    initials: 'PN',
    avatarBg: '#0a2018',
  },
  {
    quote: 'The pitch deck helped us close our seed round. Investors repeatedly commented on how clear and visual the narrative was. That\'s the Valstrid difference — clarity through design.',
    person: 'James Okafor',
    title: 'Founder',
    company: 'Vale',
    initials: 'JO',
    avatarBg: '#221200',
  },
  {
    quote: 'Four weeks, complete visual identity — logo, guidelines, website, social kit. I\'ve never seen anyone move that fast without compromising quality. Already hired again for version two.',
    person: 'Alice Bergmann',
    title: 'CMO',
    company: 'Foundry Labs',
    initials: 'AB',
    avatarBg: '#180820',
  },
  {
    quote: 'The Framer build blew our engineers away. Custom animations, CMS, perfect performance scores. Couldn\'t tell it wasn\'t hand-coded. Would recommend without hesitation.',
    person: 'Tom Hayashi',
    title: 'CTO',
    company: 'Syncline AI',
    initials: 'TH',
    avatarBg: '#081c12',
  },
];
---

<section class="testimonials" id="testimonials">

  <div class="testi-header reveal">
    <span class="section-label">Testimonials</span>
    <h2 class="headline testi-headline">What clients say</h2>
  </div>

  <div class="testi-grid">
    {testimonials.map((t, i) => (
      <div
        class={`testi-card card reveal reveal-delay-${(i % 3) + 1}`}
        style={`--avatar-bg: ${t.avatarBg};`}
      >
        <div class="testi-quote-mark" aria-hidden="true">"</div>
        <p class="testi-quote">{t.quote}</p>
        <div class="testi-author">
          <div class="testi-avatar" aria-hidden="true">{t.initials}</div>
          <div class="testi-meta">
            <span class="testi-name">{t.person}</span>
            <span class="testi-role">{t.title}, {t.company}</span>
          </div>
        </div>
      </div>
    ))}
  </div>

</section>

<style>
  .testimonials {
    padding-block: var(--section-py);
    padding-inline: var(--section-px);
    border-bottom: 1px solid var(--border);
  }

  .testi-header {
    margin-bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .testi-headline {
    font-size: clamp(30px, 4vw, 48px);
  }

  /* Grid */
  .testi-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  /* Card */
  .testi-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition:
      border-color 0.3s var(--ease-out),
      transform 0.4s var(--ease-spring);
  }

  .testi-card:hover {
    border-color: var(--border-2);
    transform: translateY(-3px);
  }

  .testi-quote-mark {
    font-family: var(--font-serif);
    font-size: 48px;
    line-height: 0.6;
    color: var(--accent);
    opacity: 0.35;
    user-select: none;
    margin-bottom: 2px;
  }

  .testi-quote {
    font-size: 13px;
    line-height: 1.75;
    color: var(--text-2);
    flex: 1;
  }

  /* Author */
  .testi-author {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
    margin-top: 4px;
  }

  .testi-avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--avatar-bg);
    border: 1px solid rgba(255,255,255,0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 700;
    color: rgba(255,255,255,0.5);
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .testi-meta {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .testi-name {
    font-size: 12px;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .testi-role {
    font-size: 11px;
    color: var(--text-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 960px) {
    .testi-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 560px) {
    .testi-grid { grid-template-columns: 1fr; }
    .testi-card { padding: 18px; }
  }
</style>
