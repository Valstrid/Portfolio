---
const clients = [
  {
    company: 'Build Club',
    person: 'Sarah Chen',
    title: 'Co-founder & CEO',
    quote: 'Working with Valstrid was exceptional. The site launched in under 4 weeks and we saw a 3× increase in signups within the first month.',
  },
  {
    company: 'Arconic Capital',
    person: 'Marcus Reid',
    title: 'Managing Partner',
    quote: 'Valstrid redesigned our investor portal from the ground up. LPs immediately noticed the difference — polished, professional, and exactly on-brand.',
  },
  {
    company: 'Preve Health',
    person: 'Priya Nair',
    title: 'Head of Product',
    quote: 'Few designers combine strategic thinking with execution speed like Valstrid. The brand feels like us — but the best version of us.',
  },
  {
    company: 'Vale',
    person: 'James Okafor',
    title: 'Founder',
    quote: 'The pitch deck helped us close our seed round. Investors repeatedly commented on how clear and visual the narrative was.',
  },
  {
    company: 'Foundry Labs',
    person: 'Alice Bergmann',
    title: 'CMO',
    quote: 'Four weeks: complete visual identity, logo, guidelines, website, and social kit. I\'ve never seen anyone move that fast without compromising quality.',
  },
  {
    company: 'Syncline AI',
    person: 'Tom Hayashi',
    title: 'CTO',
    quote: 'The Framer build blew our engineers away — custom animations, CMS, perfect performance scores. Couldn\'t tell it wasn\'t hand-coded.',
  },
  {
    company: 'IBM Design',
    person: 'Amara Osei',
    title: 'Design Lead',
    quote: 'Clean execution across a multi-touchpoint project. Everything from brand to Framer docs delivered ahead of schedule.',
  },
  {
    company: 'Paperbark.ai',
    person: 'Jake Morrison',
    title: 'Co-founder',
    quote: 'Valstrid took a vague brief and turned it into a brand identity that immediately resonated with our users. Strong press coverage on launch day.',
  },
];

const navLinks = [
  { label: 'Latest projects', section: 'work', href: '#work' },
  { label: 'Services', section: 'services', href: '#services' },
  { label: 'Testimonials', section: 'testimonials', href: '#testimonials' },
  { label: 'FAQ', section: 'faq', href: '#faq' },
  { label: 'Contact', section: 'contact', href: '#contact' },
];
---

<aside class="sidebar" id="sidebar" aria-label="Site sidebar">
  <div class="sidebar-inner">

    <!-- Brand row (always visible) -->
    <div class="sidebar-brand">
      <a href="/" class="sidebar-wordmark" aria-label="Valstrid home">
        <span class="sidebar-mark">V</span>
        <span class="sidebar-name">Valstrid</span>
      </a>
      <div class="sidebar-avail" aria-label="Available for new projects">
        <span class="avail-dot" aria-hidden="true"></span>
        <span class="avail-text">Available</span>
      </div>
    </div>

    <!-- Tagline (always visible) -->
    <p class="sidebar-tagline">
      Web &amp; brand design for ambitious companies
    </p>

    <!-- Switch zone: clients panel ↔ nav panel -->
    <div class="sidebar-switch" id="sidebar-switch">

      <!-- Panel A: Client list (visible until work section is fully passed) -->
      <div class="sidebar-clients" id="sidebar-clients-panel" aria-label="Select clients">
        <span class="panel-label">Select clients</span>
        <div class="clients-list">
          {clients.map((client, i) => (
            <div class="client-item" tabindex="0" role="button" aria-expanded="false" aria-label={client.company}>
              <div class="client-row">
                <span class="client-name">{client.company}</span>
                <svg class="client-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2 10L10 2M10 2H4M10 2V8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <div class="client-body" id={`cb-${i}`} aria-hidden="true">
                <div class="client-body-inner">
                  <p class="client-quote">"{client.quote}"</p>
                  <div class="client-author">
                    <span class="client-person">{client.person}</span>
                    <span class="client-role">{client.title}</span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Panel B: Section navigation (visible after scrolling past work section) -->
      <nav class="sidebar-nav-panel" id="sidebar-nav-panel" aria-label="Page sections">
        <span class="panel-label">Navigation</span>
        <div class="nav-links">
          {navLinks.map(link => (
            <a
              href={link.href}
              class="nav-link"
              data-section={link.section}
              aria-label={`Go to ${link.label}`}
            >
              <span class="nav-line" aria-hidden="true"></span>
              <span class="nav-label-text">{link.label}</span>
            </a>
          ))}
        </div>
      </nav>

    </div><!-- /sidebar-switch -->

    <!-- Footer CTA (always visible) -->
    <div class="sidebar-footer">
      <a href="#contact" class="btn btn-primary sidebar-cta">
        Book a call
        <svg class="arrow-icon" width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 12L12 2M12 2H5M12 2V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

  </div>
</aside>

<style>
  /* ---- Sidebar shell ---- */
  /* position:fixed keeps sidebar always visible regardless of scroll.
     sticky breaks when html/body have overflow-x:hidden */
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--sidebar-w);
    height: 100vh;
    overflow: hidden;
    background: var(--bg);
    border-right: 1px solid var(--border);
    z-index: 50;
  }

  .sidebar-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 28px 22px;
    gap: 0;
  }

  /* ---- Brand ---- */
  .sidebar-brand {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    flex-shrink: 0;
  }

  .sidebar-wordmark {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .sidebar-mark {
    width: 30px;
    height: 30px;
    background: var(--accent);
    border-radius: 7px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 17px;
    color: #000;
    flex-shrink: 0;
  }

  .sidebar-name {
    font-family: var(--font-serif);
    font-size: 16px;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  /* Available badge */
  .sidebar-avail {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    background: rgba(201, 243, 29, 0.07);
    border: 1px solid rgba(201, 243, 29, 0.16);
    border-radius: var(--radius-pill);
    flex-shrink: 0;
  }

  .avail-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse-avail 2.2s ease-in-out infinite;
  }

  @keyframes pulse-avail {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .avail-text {
    font-size: 10px;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.04em;
  }

  /* ---- Tagline ---- */
  .sidebar-tagline {
    font-size: 12px;
    line-height: 1.6;
    color: var(--text-3);
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 20px;
    flex-shrink: 0;
  }

  /* ---- Switch zone ---- */
  .sidebar-switch {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden; /* clip absolute panels to this zone */
  }

  /* Both panels fill the switch zone absolutely */
  .sidebar-clients,
  .sidebar-nav-panel {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
    transition: opacity 0.38s var(--ease-out), transform 0.38s var(--ease-out);
  }

  .sidebar-clients::-webkit-scrollbar,
  .sidebar-nav-panel::-webkit-scrollbar { display: none; }

  /* Panel A: clients — visible by default */
  .sidebar-clients {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* Panel B: nav — hidden by default */
  .sidebar-nav-panel {
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
  }

  /* When sidebar has nav-mode class */
  .sidebar.nav-mode .sidebar-clients {
    opacity: 0;
    transform: translateY(-10px);
    pointer-events: none;
  }

  .sidebar.nav-mode .sidebar-nav-panel {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* ---- Panel label ---- */
  .panel-label {
    display: block;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 10px;
  }

  /* ---- Client list (Panel A) ---- */
  .clients-list {
    display: flex;
    flex-direction: column;
  }

  .client-item {
    border-bottom: 1px solid var(--border);
    outline: none;
  }

  .client-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 0;
    cursor: default;
  }

  .client-name {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-2);
    transition: color 0.2s;
    flex: 1;
  }

  .client-arrow {
    color: var(--text-3);
    opacity: 0;
    transition: opacity 0.2s, transform 0.3s var(--ease-spring), color 0.2s;
    flex-shrink: 0;
  }

  /* Hover + focus: reveal testimonial */
  .client-item:hover .client-name,
  .client-item:focus .client-name {
    color: var(--text);
  }

  .client-item:hover .client-arrow,
  .client-item:focus .client-arrow {
    opacity: 1;
    color: var(--accent);
  }

  /* Accordion body — CSS hover only */
  .client-body {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition:
      max-height 0.42s var(--ease-out),
      opacity 0.32s var(--ease-out);
  }

  .client-item:hover .client-body,
  .client-item:focus .client-body,
  .client-item:focus-within .client-body {
    max-height: 220px;
    opacity: 1;
  }

  .client-body-inner {
    padding: 0 0 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .client-quote {
    font-size: 12px;
    line-height: 1.7;
    color: var(--text-3);
    font-style: italic;
  }

  .client-author {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .client-person {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-2);
  }

  .client-role {
    font-size: 11px;
    color: var(--text-3);
  }

  /* ---- Nav links (Panel B) ---- */
  .nav-links {
    display: flex;
    flex-direction: column;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--text-3);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: -0.01em;
    transition: color 0.2s;
    position: relative;
  }

  .nav-line {
    display: block;
    width: 14px;
    height: 1px;
    background: var(--text-3);
    flex-shrink: 0;
    transition: width 0.3s var(--ease-out), background 0.2s;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
  }

  .nav-link:hover .nav-line,
  .nav-link.active .nav-line {
    width: 22px;
    background: var(--accent);
  }

  .nav-label-text {
    line-height: 1;
  }

  /* ---- Footer CTA ---- */
  .sidebar-footer {
    padding-top: 20px;
    margin-top: 20px;
    border-top: 1px solid var(--border);
    flex-shrink: 0;
  }

  .sidebar-cta {
    width: 100%;
    justify-content: center;
    padding: 10px 18px;
    font-size: 13px;
  }

  /* ---- Mobile drawer ---- */
  /* On mobile the sidebar slides off-screen by default.
     position:fixed and left:0 are inherited from base CSS. */
  @media (max-width: 960px) {
    .sidebar {
      top: 56px; /* below the fixed mobile header */
      height: calc(100vh - 56px);
      /* width already set in base: var(--sidebar-w) */
      transform: translateX(-100%);
      transition: transform 0.35s var(--ease-out);
      z-index: 100; /* above overlay (99) */
      border-right: 1px solid var(--border-2);
    }

    .sidebar.mobile-open {
      transform: translateX(0);
    }
  }
</style>

<script>
  // ---- Work observer: toggle nav-mode on sidebar after section is fully passed ----
  const sidebar  = document.getElementById('sidebar')!;
  const workSection = document.getElementById('work');

  if (workSection) {
    const workObs = new IntersectionObserver(
      ([entry]) => {
        const hasPassedWork = !entry.isIntersecting && entry.boundingClientRect.bottom <= 0;
        sidebar.classList.toggle('nav-mode', hasPassedWork);
      },
      { threshold: 0.05 }
    );
    workObs.observe(workSection);
  }

  // ---- Section observer: highlight active nav link ----
  const navLinks = document.querySelectorAll<HTMLElement>('.nav-link');
  const sectionIds = ['work', 'services', 'testimonials', 'faq', 'contact'];

  const activeSections = new Set<string>();

  const sectionObs = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        const id = entry.target.id;
        if (entry.isIntersecting) {
          activeSections.add(id);
        } else {
          activeSections.delete(id);
        }
      });

      // Highlight first active section in page order
      const firstActive = sectionIds.find(id => activeSections.has(id));
      navLinks.forEach(link => {
        link.classList.toggle('active', link.dataset.section === firstActive);
      });
    },
    { rootMargin: '-15% 0px -60% 0px', threshold: 0 }
  );

  sectionIds.forEach(id => {
    const el = document.getElementById(id);
    if (el) sectionObs.observe(el);
  });

  // ---- Hover: update aria-expanded for accessibility ----
  document.querySelectorAll<HTMLElement>('.client-item').forEach(item => {
    item.addEventListener('mouseenter', () => {
      item.setAttribute('aria-expanded', 'true');
    });
    item.addEventListener('mouseleave', () => {
      item.setAttribute('aria-expanded', 'false');
    });
    item.addEventListener('focus', () => {
      item.setAttribute('aria-expanded', 'true');
    });
    item.addEventListener('blur', () => {
      item.setAttribute('aria-expanded', 'false');
    });
  });
</script>
