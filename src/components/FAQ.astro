---
const faqs = [
  {
    question: 'How long does a typical project take?',
    answer: 'Most projects are delivered in 2–4 weeks depending on scope. A landing page typically takes 2 weeks. A full brand + website takes 4–6 weeks. I use clear milestones so you always know where we are.',
  },
  {
    question: 'What are your rates?',
    answer: 'Projects start at $3,000 for smaller scopes. A typical web design + build engagement runs $5,000–$10,000. Brand identity starts at $4,000. I\'ll always provide a fixed-price proposal so there are no surprises.',
  },
  {
    question: 'How do we communicate during the project?',
    answer: 'Primarily through Slack for quick updates and Loom for design walkthroughs. We\'ll also have structured check-ins at key milestones. I aim to respond within a few hours during business days.',
  },
  {
    question: 'Do you offer ongoing support after launch?',
    answer: 'Yes — I offer flexible retainer plans for updates, maintenance, and ongoing design work. Many clients keep me on after launch for minor tweaks, new pages, or campaign assets.',
  },
  {
    question: 'Can you work with an existing brand or website?',
    answer: 'Absolutely. I handle both greenfield projects and redesigns. If you have an existing brand, I\'ll work within or evolve it. If your site just needs a refresh, I can scope that too.',
  },
  {
    question: 'What if I only need one part — like just branding or just development?',
    answer: 'That\'s totally fine. Each service — branding, web design, and Framer development — can be scoped independently. Just reach out and we\'ll figure out exactly what you need.',
  },
];
---

<section class="faq" id="faq">
  <div class="container">

    <div class="faq-header reveal">
      <p class="section-label">Questions</p>
      <h2 class="headline faq-headline">Frequently asked</h2>
    </div>

    <div class="faq-list" role="list">
      {faqs.map((item, i) => (
        <div class={`faq-item reveal reveal-delay-${(i % 3) + 1}`} role="listitem">
          <button
            class="faq-trigger"
            aria-expanded="false"
            aria-controls={`faq-answer-${i}`}
          >
            <span class="faq-question">{item.question}</span>
            <span class="faq-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <path class="icon-v" d="M4 9h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path class="icon-h" d="M9 4v10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </span>
          </button>
          <div
            class="faq-answer"
            id={`faq-answer-${i}`}
            role="region"
            aria-hidden="true"
          >
            <p class="faq-answer-text">{item.answer}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .faq {
    padding-block: var(--section-py);
    border-top: 1px solid var(--border);
  }

  .faq-header {
    margin-bottom: 56px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .faq-headline {
    max-width: 400px;
  }

  /* List */
  .faq-list {
    max-width: 780px;
    display: flex;
    flex-direction: column;
  }

  .faq-item {
    border-bottom: 1px solid var(--border);
  }

  .faq-item:first-child {
    border-top: 1px solid var(--border);
  }

  /* Trigger */
  .faq-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 0;
    text-align: left;
    background: transparent;
    cursor: pointer;
    transition: color 0.2s;
  }

  .faq-trigger:hover { color: var(--text); }

  .faq-question {
    font-size: clamp(16px, 2vw, 20px);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text);
    flex: 1;
    line-height: 1.3;
  }

  .faq-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--text-2);
    flex-shrink: 0;
    transition: background 0.25s, border-color 0.25s, color 0.25s, transform 0.3s var(--ease-out);
  }

  .faq-trigger[aria-expanded="true"] .faq-icon {
    background: var(--accent);
    border-color: var(--accent);
    color: #000;
    transform: rotate(45deg);
  }

  .icon-h {
    transition: opacity 0.25s;
  }

  .faq-trigger[aria-expanded="true"] .icon-h {
    opacity: 0;
  }

  /* Answer */
  .faq-answer {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.4s var(--ease-out);
  }

  .faq-answer[aria-hidden="false"] {
    max-height: 200px;
  }

  .faq-answer-text {
    padding-bottom: 24px;
    font-size: 15px;
    line-height: 1.75;
    color: var(--text-2);
    max-width: 640px;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.faq-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      const answerId = btn.getAttribute('aria-controls')!;
      const answer = document.getElementById(answerId)!;

      // Close all
      document.querySelectorAll<HTMLButtonElement>('.faq-trigger').forEach((b) => {
        b.setAttribute('aria-expanded', 'false');
        const a = document.getElementById(b.getAttribute('aria-controls')!)!;
        a.setAttribute('aria-hidden', 'true');
      });

      // Toggle current
      if (!isOpen) {
        btn.setAttribute('aria-expanded', 'true');
        answer.setAttribute('aria-hidden', 'false');
      }
    });
  });
</script>
