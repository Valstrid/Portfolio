---
const categories = [
  {
    label: 'Work & process',
    items: [
      {
        q: 'How long does a project take?',
        a: 'Most projects complete in 3–5 weeks from kickoff. A single landing page: 2 weeks. Full brand + site: 4–6 weeks. Complex multi-page builds: 6–8 weeks. I use clear milestones so you always know where we are.',
      },
      {
        q: 'What information do you need from me to start?',
        a: 'Goals, references you like (and dislike), any existing brand assets, and copy (or a clear outline of it). The more context upfront, the faster and sharper the work.',
      },
      {
        q: 'Do you work with early-stage startups?',
        a: 'Yes — many clients are pre-seed to Series A. I understand that direction can shift, so I scope projects to move quickly and adapt as needed.',
      },
      {
        q: 'Can I pay in instalments?',
        a: '50% upfront, 50% on delivery. For larger engagements I can structure milestone-based payments. I always provide a fixed-price proposal — no surprise invoices.',
      },
      {
        q: 'Do you offer ongoing retainers?',
        a: 'Yes. Many clients keep me on after launch for updates, new pages, and campaign assets. Retainers are scoped monthly with a rollover clause.',
      },
      {
        q: 'Can you work with an existing brand or website?',
        a: 'Absolutely — both greenfield and redesigns. If you have an existing brand, I work within or evolve it. If your site just needs a refresh, I can scope that too.',
      },
    ],
  },
  {
    label: 'Design & Framer',
    items: [
      {
        q: 'Do you only build in Framer?',
        a: 'Mostly Framer, but also Webflow and custom code on request. For most marketing sites, Framer gives the best balance of design fidelity, speed, and editability.',
      },
      {
        q: 'Can I edit the site myself after launch?',
        a: 'Yes — Framer CMS lets you edit all text, images, and blog content without code. I include a handoff session so you\'re confident using it independently.',
      },
      {
        q: 'Will the site look good on mobile?',
        a: 'All builds are fully responsive, tested on real devices across Chrome, Safari, and Firefox. Mobile is always a first-class concern, not an afterthought.',
      },
      {
        q: 'Do you design the copy too?',
        a: 'I can write structural copy (headlines, value props, CTAs) and provide messaging guidance. For long-form content I collaborate with copywriters and can make introductions.',
      },
      {
        q: 'What\'s your revision policy?',
        a: 'Two full revision rounds are included. Additional rounds are billed at day rate. In practice, most projects land within the included rounds because I ask the right questions upfront.',
      },
      {
        q: 'What happens after launch?',
        a: 'You get all files, Framer access, and any brand assets. I provide a short Loom walkthrough of the CMS. After that, I\'m available for ongoing work or individual requests.',
      },
    ],
  },
];
---

<section class="faq" id="faq">

  <div class="faq-header reveal">
    <span class="section-label">FAQ</span>
    <h2 class="headline faq-headline">Frequently asked</h2>
  </div>

  <div class="faq-cols">
    {categories.map((cat, ci) => (
      <div class="faq-col">
        <h3 class="faq-cat-label">{cat.label}</h3>
        <div class="faq-list">
          {cat.items.map((item, i) => (
            <div class={`faq-item reveal reveal-delay-${(i % 3) + 1}`}>
              <button
                class="faq-trigger"
                aria-expanded="false"
                aria-controls={`faq-${ci}-${i}`}
              >
                <span class="faq-q">{item.q}</span>
                <span class="faq-icon" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <path class="icon-h" d="M3 7h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path class="icon-v" d="M7 3v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </span>
              </button>
              <div
                class="faq-answer"
                id={`faq-${ci}-${i}`}
                aria-hidden="true"
              >
                <p class="faq-a">{item.a}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

</section>

<style>
  .faq {
    padding-block: var(--section-py);
    padding-inline: var(--section-px);
    border-bottom: 1px solid var(--border);
  }

  .faq-header {
    margin-bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-headline {
    font-size: clamp(30px, 4vw, 48px);
  }

  /* Two column layout */
  .faq-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 48px;
    align-items: start;
  }

  .faq-cat-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 8px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  /* Items */
  .faq-list {
    display: flex;
    flex-direction: column;
  }

  .faq-item {
    border-bottom: 1px solid var(--border);
  }

  .faq-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    text-align: left;
    cursor: pointer;
    background: transparent;
  }

  .faq-q {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-2);
    flex: 1;
    line-height: 1.4;
    letter-spacing: -0.01em;
    transition: color 0.2s;
  }

  .faq-trigger:hover .faq-q,
  .faq-trigger[aria-expanded="true"] .faq-q {
    color: var(--text);
  }

  .faq-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border: 1px solid var(--border-2);
    border-radius: 50%;
    color: var(--text-3);
    flex-shrink: 0;
    transition:
      background 0.25s,
      border-color 0.25s,
      color 0.25s;
  }

  .faq-trigger[aria-expanded="true"] .faq-icon {
    background: var(--accent);
    border-color: var(--accent);
    color: #000;
  }

  .icon-v {
    transition: opacity 0.2s, transform 0.3s var(--ease-out);
  }

  .faq-trigger[aria-expanded="true"] .icon-v {
    opacity: 0;
    transform: scaleY(0);
  }

  /* Answer */
  .faq-answer {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.4s var(--ease-out);
  }

  .faq-answer[aria-hidden="false"] {
    max-height: 220px;
  }

  .faq-a {
    padding-bottom: 18px;
    font-size: 13px;
    line-height: 1.75;
    color: var(--text-2);
  }

  @media (max-width: 768px) {
    .faq-cols {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.faq-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      const id = btn.getAttribute('aria-controls')!;
      const answer = document.getElementById(id)!;

      // Close all
      document.querySelectorAll<HTMLButtonElement>('.faq-trigger').forEach((b) => {
        b.setAttribute('aria-expanded', 'false');
        const a = document.getElementById(b.getAttribute('aria-controls')!);
        a?.setAttribute('aria-hidden', 'true');
      });

      if (!isOpen) {
        btn.setAttribute('aria-expanded', 'true');
        answer.setAttribute('aria-hidden', 'false');
      }
    });
  });
</script>
