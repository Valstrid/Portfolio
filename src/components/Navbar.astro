---
const navLinks = [
  { label: 'Work', href: '#work' },
  { label: 'Services', href: '#services' },
  { label: 'About', href: '#about' },
  { label: 'FAQ', href: '#faq' },
];
---

<header class="navbar" id="navbar">
  <div class="container nav-inner">

    <!-- Logo -->
    <a href="/" class="nav-logo" aria-label="Valstrid home">
      <span class="nav-logo-text">Valstrid</span>
      <span class="nav-logo-dot"></span>
    </a>

    <!-- Desktop Nav -->
    <nav class="nav-links" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link link-underline">
          {link.label}
        </a>
      ))}
    </nav>

    <!-- CTA + Hamburger -->
    <div class="nav-actions">
      <a href="#contact" class="btn btn-primary nav-cta">
        Book a call
        <svg class="arrow-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 12L12 2M12 2H5M12 2V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <button class="hamburger btn-icon" id="hamburger" aria-label="Toggle menu" aria-expanded="false">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav class="mobile-nav">
      {navLinks.map((link, i) => (
        <a href={link.href} class="mobile-nav-link" style={`--i: ${i}`}>
          {link.label}
        </a>
      ))}
      <a href="#contact" class="btn btn-primary mobile-cta">Book a call →</a>
    </nav>
  </div>
</header>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding-block: 16px;
    transition: background 0.4s var(--ease-out), backdrop-filter 0.4s, border-bottom 0.4s;
    border-bottom: 1px solid transparent;
  }

  .navbar.scrolled {
    background: rgba(8, 8, 8, 0.85);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  /* Logo */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .nav-logo-text {
    font-family: var(--font-serif);
    font-size: 22px;
    letter-spacing: -0.02em;
    color: var(--text);
    transition: opacity 0.2s;
  }

  .nav-logo:hover .nav-logo-text { opacity: 0.7; }

  .nav-logo-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    margin-bottom: 2px;
  }

  /* Desktop nav */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-link {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-2);
    transition: color 0.2s;
  }

  .nav-link:hover { color: var(--text); }

  /* Actions */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .nav-cta {
    padding: 10px 20px;
    font-size: 13px;
  }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border-2);
    border-radius: var(--radius-sm);
    padding: 8px;
    transition: border-color 0.2s;
  }

  .hamburger:hover { border-color: var(--text-3); }

  .hamburger-line {
    display: block;
    width: 100%;
    height: 1.5px;
    background: var(--text);
    border-radius: 999px;
    transition: transform 0.3s var(--ease-out), opacity 0.3s;
    transform-origin: center;
  }

  .hamburger.open .hamburger-line:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .hamburger.open .hamburger-line:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* Mobile menu */
  .mobile-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--bg-2);
    border-bottom: 1px solid var(--border);
    padding: 24px;
    transform: translateY(-8px);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.35s var(--ease-out), opacity 0.35s var(--ease-out);
  }

  .mobile-menu.open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: all;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-nav-link {
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-2);
    padding: 10px 0;
    transition: color 0.2s, transform 0.3s var(--ease-out);
    transform: translateX(-8px);
    opacity: 0;
    border-bottom: 1px solid var(--border);
  }

  .mobile-menu.open .mobile-nav-link {
    transform: translateX(0);
    opacity: 1;
    transition-delay: calc(var(--i) * 0.06s);
  }

  .mobile-nav-link:hover { color: var(--text); }

  .mobile-cta {
    margin-top: 20px;
    align-self: flex-start;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .nav-links { display: none; }
    .hamburger { display: flex; }
    .nav-cta { display: none; }
    .mobile-menu { display: block; }
  }
</style>

<script>
  const navbar = document.getElementById('navbar') as HTMLElement;
  const hamburger = document.getElementById('hamburger') as HTMLButtonElement;
  const mobileMenu = document.getElementById('mobile-menu') as HTMLElement;

  // Scrolled state
  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) {
      navbar.classList.add('scrolled');
    } else {
      navbar.classList.remove('scrolled');
    }
  }, { passive: true });

  // Hamburger toggle
  hamburger.addEventListener('click', () => {
    const isOpen = hamburger.classList.toggle('open');
    hamburger.setAttribute('aria-expanded', String(isOpen));
    mobileMenu.classList.toggle('open', isOpen);
    mobileMenu.setAttribute('aria-hidden', String(!isOpen));
  });

  // Close mobile menu on link click
  mobileMenu.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      hamburger.classList.remove('open');
      hamburger.setAttribute('aria-expanded', 'false');
      mobileMenu.classList.remove('open');
      mobileMenu.setAttribute('aria-hidden', 'true');
    });
  });
</script>
