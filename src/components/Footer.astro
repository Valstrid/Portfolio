---
const socials = [
  { label: 'Twitter / X', href: 'https://twitter.com/' },
  { label: 'LinkedIn', href: 'https://linkedin.com/' },
  { label: 'Dribbble', href: 'https://dribbble.com/' },
];
---

<!-- Contact / CTA -->
<section class="contact" id="contact">

  <div class="contact-content">

    <div class="contact-left reveal">
      <span class="section-label">Let's work together</span>
      <h2 class="display contact-headline">
        Let's build<br />
        something great.
      </h2>
      <p class="contact-desc body-lg">
        Book a free 15-minute intro call. No obligation — just a quick
        conversation to see if we're a good fit.
      </p>
      <div class="contact-actions">
        <a href="mailto:hello@valstrid.com" class="btn btn-primary contact-btn">
          Book an intro call
          <svg class="arrow-icon" width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 12L12 2M12 2H5M12 2V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="mailto:hello@valstrid.com" class="contact-email link-underline">
          hello@valstrid.com
        </a>
      </div>
    </div>

    <!-- Cal.com placeholder -->
    <div class="contact-cal reveal reveal-delay-2">
      <div class="cal-placeholder">
        <div class="cal-header">
          <div class="cal-dot cal-dot-red"></div>
          <div class="cal-dot cal-dot-yellow"></div>
          <div class="cal-dot cal-dot-green"></div>
          <span class="cal-title">cal.com/valstrid</span>
        </div>
        <div class="cal-body">
          <div class="cal-month">
            <span class="cal-month-label">June 2026</span>
            <div class="cal-grid">
              {[...Array(28)].map((_, i) => {
                const day = i + 1;
                const available = [3, 5, 10, 12, 17, 19, 24, 26].includes(day);
                return (
                  <button
                    class={`cal-day ${available ? 'cal-day-available' : ''}`}
                    aria-label={available ? `Book ${day} June` : `${day} June, unavailable`}
                    disabled={!available}
                  >
                    {day}
                  </button>
                );
              })}
            </div>
          </div>
          <p class="cal-note">Select a date to see available slots</p>
        </div>
      </div>
    </div>

  </div>

</section>

<!-- Footer -->
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-left">
      <a href="/" class="footer-wordmark" aria-label="Valstrid home">Valstrid</a>
      <span class="footer-tagline">Web & Brand Design</span>
    </div>
    <div class="footer-right">
      <nav class="footer-socials" aria-label="Social links">
        {socials.map(s => (
          <a href={s.href} class="footer-social link-underline" target="_blank" rel="noopener noreferrer">
            {s.label}
          </a>
        ))}
      </nav>
      <p class="footer-copy">© {new Date().getFullYear()} Valstrid</p>
    </div>
  </div>
</footer>

<style>
  /* ---- Contact ---- */
  .contact {
    padding-block: var(--section-py);
    padding-inline: var(--section-px);
    border-bottom: 1px solid var(--border);
  }

  .contact-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .contact-left {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact-headline {
    font-size: clamp(36px, 5vw, 60px);
    line-height: 1.05;
  }

  .contact-desc {
    font-size: 15px;
    max-width: 380px;
  }

  .contact-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .contact-btn {
    padding: 13px 26px;
    font-size: 14px;
  }

  .contact-email {
    font-size: 13px;
    color: var(--text-3);
    transition: color 0.2s;
  }

  .contact-email:hover { color: var(--text-2); }

  /* Cal.com placeholder */
  .cal-placeholder {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .cal-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-2);
  }

  .cal-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .cal-dot-red { background: #ff5f57; }
  .cal-dot-yellow { background: #febc2e; }
  .cal-dot-green { background: #28c840; }

  .cal-title {
    font-size: 11px;
    color: var(--text-3);
    margin-left: 4px;
    font-family: var(--font-sans);
  }

  .cal-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cal-month {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cal-month-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-2);
    letter-spacing: -0.01em;
  }

  .cal-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
  }

  .cal-day {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    font-size: 11px;
    color: var(--text-3);
    background: transparent;
    border: none;
    cursor: default;
    transition: background 0.2s, color 0.2s;
  }

  .cal-day-available {
    background: rgba(201, 243, 29, 0.08);
    color: var(--accent);
    cursor: pointer;
    border: 1px solid rgba(201, 243, 29, 0.15);
  }

  .cal-day-available:hover {
    background: rgba(201, 243, 29, 0.16);
    border-color: rgba(201, 243, 29, 0.3);
  }

  .cal-note {
    font-size: 11px;
    color: var(--text-3);
    text-align: center;
  }

  /* ---- Footer ---- */
  .footer {
    padding-block: 24px;
    padding-inline: var(--section-px);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .footer-wordmark {
    font-family: var(--font-serif);
    font-size: 15px;
    letter-spacing: -0.02em;
    color: var(--text-2);
    transition: color 0.2s;
  }

  .footer-wordmark:hover { color: var(--text); }

  .footer-tagline {
    font-size: 12px;
    color: var(--text-3);
  }

  .footer-right {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .footer-social {
    font-size: 12px;
    color: var(--text-3);
    transition: color 0.2s;
  }

  .footer-social:hover { color: var(--text-2); }

  .footer-copy {
    font-size: 12px;
    color: var(--text-3);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .contact-content {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 480px) {
    .footer-inner { flex-direction: column; align-items: flex-start; gap: 16px; }
    .footer-right { flex-direction: column; align-items: flex-start; gap: 12px; }
  }
</style>
