---
---

<section class="hero" id="hero">

  <!-- Top label row -->
  <div class="hero-label reveal">
    <span class="section-label">Valstrid</span>
    <span class="hero-label-sep" aria-hidden="true">—</span>
    <span class="section-label">Web &amp; Brand Design</span>
  </div>

  <!-- Main heading -->
  <div class="hero-headline-wrap">
    <h1 class="hero-headline reveal reveal-delay-1">
      Crafting digital<br />
      experiences for<br />
      <em class="hero-em">ambitious</em> companies
    </h1>
  </div>

  <!-- Description -->
  <p class="hero-desc body-lg reveal reveal-delay-2">
    Sharp, conversion-focused design for B2B companies, AI startups,
    and investment firms — from brand identity to production-ready Framer sites.
  </p>

  <!-- CTAs -->
  <div class="hero-actions reveal reveal-delay-3">
    <a href="#contact" class="btn btn-primary hero-cta">
      Book an intro call
      <svg class="arrow-icon" width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M2 12L12 2M12 2H5M12 2V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
    <a href="#work" class="btn btn-ghost">View work</a>
  </div>

  <!-- Stats row -->
  <div class="hero-stats reveal reveal-delay-4">
    <div class="stat">
      <span class="stat-number">40<span class="stat-plus">+</span></span>
      <span class="stat-label">Projects delivered</span>
    </div>
    <span class="stat-sep" aria-hidden="true"></span>
    <div class="stat">
      <span class="stat-number">4<span class="stat-unit">yrs</span></span>
      <span class="stat-label">Experience</span>
    </div>
    <span class="stat-sep" aria-hidden="true"></span>
    <div class="stat">
      <span class="stat-number">28<span class="stat-unit">d</span></span>
      <span class="stat-label">Avg. delivery</span>
    </div>
    <span class="stat-sep" aria-hidden="true"></span>
    <div class="stat">
      <span class="stat-number">100<span class="stat-plus">%</span></span>
      <span class="stat-label">Client satisfaction</span>
    </div>
  </div>

  <!-- Background glow -->
  <div class="hero-glow" aria-hidden="true"></div>

</section>

<style>
  .hero {
    padding-block: clamp(64px, 9vw, 120px);
    padding-inline: var(--section-px);
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }

  /* Label row */
  .hero-label {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 32px;
  }

  .hero-label-sep {
    color: var(--text-3);
    font-size: 11px;
  }

  /* Headline */
  .hero-headline-wrap {
    margin-bottom: 24px;
    overflow: hidden;
  }

  .hero-headline {
    font-family: var(--font-serif);
    font-size: clamp(42px, 6vw, 80px);
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .hero-em {
    font-style: italic;
    color: var(--text-3);
  }

  /* Description */
  .hero-desc {
    max-width: 500px;
    margin-bottom: 36px;
    font-size: clamp(15px, 1.5vw, 17px);
  }

  /* Actions */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 56px;
    flex-wrap: wrap;
  }

  .hero-cta {
    padding: 13px 26px;
    font-size: 14px;
  }

  /* Stats */
  .hero-stats {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
    padding-top: 40px;
    border-top: 1px solid var(--border);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .stat-number {
    font-family: var(--font-serif);
    font-size: 26px;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--text);
  }

  .stat-plus, .stat-unit {
    font-family: var(--font-serif);
    font-size: 18px;
    color: var(--accent);
    font-style: normal;
  }

  .stat-label {
    font-size: 11px;
    color: var(--text-3);
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  .stat-sep {
    width: 1px;
    height: 28px;
    background: var(--border);
    flex-shrink: 0;
  }

  /* Background */
  .hero-glow {
    position: absolute;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(201, 243, 29, 0.04) 0%, transparent 70%);
    top: -120px;
    right: -100px;
    pointer-events: none;
    z-index: -1;
  }

  @media (max-width: 640px) {
    .hero-stats { gap: 20px; }
    .stat-sep { display: none; }
  }
</style>
