---
---

<section class="hero" id="hero">
  <div class="container hero-inner">

    <!-- Badge -->
    <div class="hero-badge reveal">
      <span class="badge-dot"></span>
      <span>Available for new projects</span>
    </div>

    <!-- Headline -->
    <h1 class="display hero-headline reveal reveal-delay-1">
      Web and brand design<br />
      for <em class="hero-em">ambitious</em><br />
      companies
    </h1>

    <!-- Subheadline -->
    <p class="body-lg hero-sub reveal reveal-delay-2">
      I craft sharp, conversion-focused digital experiences for B2B, AI startups,
      and investment firms — from brand identity to production-ready Framer sites.
    </p>

    <!-- CTAs -->
    <div class="hero-actions reveal reveal-delay-3">
      <a href="#contact" class="btn btn-primary hero-btn-primary">
        Book an intro call
        <svg class="arrow-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 12L12 2M12 2H5M12 2V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href="#work" class="btn btn-ghost">
        View work
      </a>
    </div>

    <!-- Scroll indicator -->
    <div class="scroll-indicator reveal reveal-delay-4" aria-hidden="true">
      <span class="scroll-label">Scroll to explore</span>
      <div class="scroll-line">
        <div class="scroll-dot"></div>
      </div>
    </div>

    <!-- Stats row -->
    <div class="hero-stats reveal reveal-delay-3">
      <div class="stat">
        <span class="stat-number">40+</span>
        <span class="stat-label">Projects delivered</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-number">4yrs</span>
        <span class="stat-label">Experience</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-number">28d</span>
        <span class="stat-label">Avg. delivery</span>
      </div>
    </div>

  </div>

  <!-- Background gradient -->
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-glow hero-glow-1"></div>
    <div class="hero-glow hero-glow-2"></div>
    <div class="hero-grid"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: 100px;
    padding-bottom: var(--section-py);
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 820px;
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: rgba(201, 243, 29, 0.08);
    border: 1px solid rgba(201, 243, 29, 0.2);
    border-radius: var(--radius-pill);
    font-size: 13px;
    font-weight: 500;
    color: var(--accent);
    align-self: flex-start;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
  }

  /* Headline */
  .hero-headline {
    font-size: clamp(52px, 8vw, 100px);
  }

  .hero-em {
    font-style: italic;
    color: var(--text-2);
  }

  /* Subheadline */
  .hero-sub {
    max-width: 540px;
  }

  /* Actions */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hero-btn-primary {
    padding: 16px 32px;
    font-size: 15px;
  }

  /* Stats */
  .hero-stats {
    display: flex;
    align-items: center;
    gap: 32px;
    padding-top: 8px;
    flex-wrap: wrap;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat-number {
    font-family: var(--font-serif);
    font-size: 28px;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--text);
  }

  .stat-label {
    font-size: 12px;
    color: var(--text-3);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .stat-divider {
    width: 1px;
    height: 32px;
    background: var(--border);
  }

  /* Scroll indicator */
  .scroll-indicator {
    display: flex;
    align-items: center;
    gap: 12px;
    position: absolute;
    bottom: 40px;
    right: clamp(20px, 5vw, 60px);
  }

  .scroll-label {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .scroll-line {
    width: 1px;
    height: 60px;
    background: var(--border);
    position: relative;
    overflow: hidden;
  }

  .scroll-dot {
    position: absolute;
    top: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    animation: scroll-move 2s ease-in-out infinite;
  }

  @keyframes scroll-move {
    0% { top: -8px; opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { top: 68px; opacity: 0; }
  }

  /* Background */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
  }

  .hero-glow-1 {
    width: 600px;
    height: 600px;
    background: rgba(201, 243, 29, 0.04);
    top: -200px;
    right: -100px;
  }

  .hero-glow-2 {
    width: 400px;
    height: 400px;
    background: rgba(100, 150, 255, 0.04);
    bottom: 0;
    left: 20%;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 60px 60px;
    opacity: 0.35;
    mask-image: radial-gradient(ellipse at 50% 0%, black 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 0%, black 30%, transparent 80%);
  }

  @media (max-width: 768px) {
    .scroll-indicator { display: none; }
    .hero-stats { gap: 20px; }
  }
</style>
