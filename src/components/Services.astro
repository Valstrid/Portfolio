---
const services = [
  {
    title: 'Website Design & Build',
    description: 'Pixel-perfect, responsive websites designed with intent and built for performance. Landing pages to full marketing sites — live in as little as 2 weeks.',
    deliverables: ['Strategy & wireframes', 'UI/UX design', 'Responsive Framer build', 'CMS setup & handoff'],
    gradient: 'linear-gradient(135deg, #0a0f1a 0%, #0d1f38 100%)',
    accent: '#4e9dff',
    icon: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="24" height="17" rx="2"/><path d="M9 25h10M14 21v4"/></svg>`,
  },
  {
    title: 'Brand & Visual Identity',
    description: 'More than a logo — a complete visual language that communicates your values and differentiates you in a crowded market. Built to scale.',
    deliverables: ['Logo & mark design', 'Color & type system', 'Brand guidelines', 'Asset library'],
    gradient: 'linear-gradient(135deg, #0f0a00 0%, #201800 100%)',
    accent: '#f0b429',
    icon: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="14" cy="14" r="10"/><path d="M14 4v20M4 14h20"/><path d="M7.5 7.5l13 13M20.5 7.5l-13 13"/></svg>`,
  },
  {
    title: 'Framer Development',
    description: 'Advanced Framer builds with custom interactions, animations, and CMS integration. As a Framer PRO Expert, I take sites far beyond what templates allow.',
    deliverables: ['Custom interactions & motion', 'CMS integration', 'Performance tuning', 'Ongoing support'],
    gradient: 'linear-gradient(135deg, #050f0a 0%, #0a1f14 100%)',
    accent: '#c9f31d',
    icon: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 22 24 14 18 6"/><polyline points="10 6 4 14 10 22"/><line x1="14" y1="2" x2="14" y2="26"/></svg>`,
  },
];
---

<section class="services" id="services">

  <div class="svc-header reveal">
    <span class="section-label">What I do</span>
    <h2 class="headline svc-headline">Built for your goals,<br class="svc-br"> not a template</h2>
  </div>

  <div class="svc-grid">
    {services.map((svc, i) => (
      <div
        class={`svc-card reveal reveal-delay-${i + 1}`}
        style={`--svc-gradient: ${svc.gradient}; --svc-accent: ${svc.accent};`}
      >
        <!-- Visual area -->
        <div class="svc-visual" aria-hidden="true">
          <div class="svc-visual-bg"></div>
          <div class="svc-icon-wrap" set:html={svc.icon}></div>
        </div>

        <!-- Body -->
        <div class="svc-body">
          <h3 class="svc-title">{svc.title}</h3>
          <p class="svc-desc">{svc.description}</p>
          <ul class="svc-list">
            {svc.deliverables.map(item => (
              <li class="svc-list-item">
                <span class="svc-check" aria-hidden="true">
                  <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                    <path d="M1.5 5l2.5 2.5 4.5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>

</section>

<style>
  .services {
    padding-block: var(--section-py);
    padding-inline: var(--section-px);
    border-bottom: 1px solid var(--border);
  }

  .svc-header {
    margin-bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .svc-headline {
    font-size: clamp(30px, 4vw, 48px);
  }

  .svc-br { display: none; }

  /* Grid */
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  /* Card */
  .svc-card {
    display: flex;
    flex-direction: column;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      border-color 0.3s var(--ease-out),
      transform 0.4s var(--ease-spring);
  }

  .svc-card:hover {
    border-color: var(--border-2);
    transform: translateY(-3px);
  }

  /* Visual */
  .svc-visual {
    position: relative;
    height: 130px;
    overflow: hidden;
  }

  .svc-visual-bg {
    position: absolute;
    inset: 0;
    background: var(--svc-gradient);
  }

  .svc-icon-wrap {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--svc-accent);
    opacity: 0.7;
    transition: opacity 0.3s, transform 0.4s var(--ease-spring);
  }

  .svc-card:hover .svc-icon-wrap {
    opacity: 1;
    transform: scale(1.1);
  }

  /* Top accent line on hover */
  .svc-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--svc-accent);
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
    z-index: 2;
  }

  .svc-card:hover::before { opacity: 0.7; }
  .svc-card { position: relative; }

  /* Body */
  .svc-body {
    padding: 22px 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .svc-title {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
    line-height: 1.3;
  }

  .svc-desc {
    font-size: 13px;
    line-height: 1.7;
    color: var(--text-2);
  }

  /* List */
  .svc-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 4px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }

  .svc-list-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--text-2);
  }

  .svc-check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(201, 243, 29, 0.08);
    color: var(--accent);
    flex-shrink: 0;
  }

  @media (max-width: 960px) {
    .svc-grid { grid-template-columns: 1fr; }
    .svc-br { display: inline; }
  }

  @media (max-width: 640px) {
    .svc-visual { height: 110px; }
  }
</style>
